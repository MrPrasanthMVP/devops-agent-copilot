{
  "inputs": [
    {
      "type": "promptString",
      "id": "bitbucket-token",
      "description": "Bitbucket Data Center personal access token (Bearer). Never committed; stored by VS Code's secret storage.",
      "password": true
    },
    {
      "type": "promptString",
      "id": "jfrog-token",
      "description": "JFrog Platform access token (Bearer). Never committed; stored by VS Code's secret storage.",
      "password": true
    },
    {
      "type": "promptString",
      "id": "sonarqube-token",
      "description": "SonarQube user token (Server/Community Build self-managed, or Cloud). Never committed; stored by VS Code's secret storage.",
      "password": true
    }
  ],
  "servers": {
    "bitbucket-dc": {
      "type": "http",
      "url": "https://bitbucket.example.internal/rest/mcp/1.0/",
      "headers": {
        "Authorization": "Bearer ${input:bitbucket-token}"
      }
    },
    "atlassian-rovo": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "jfrog": {
      "type": "http",
      "url": "https://artifactory.example.internal/mcp",
      "headers": {
        "Authorization": "Bearer ${input:jfrog-token}"
      }
    },
    "sonarqube": {
      "type": "stdio",
      "command": "docker",
      "args": ["run", "--init", "--pull=always", "-i", "--rm", "-e", "SONARQUBE_TOKEN", "-e", "SONARQUBE_URL", "sonarsource/sonarqube-mcp"],
      "env": {
        "SONARQUBE_TOKEN": "${input:sonarqube-token}",
        "SONARQUBE_URL": "https://sonarqube.example.internal"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    }
  }
}
